{
  "color": {
    "$type": "color",
    "primitive": {
      "blue": {
        "50": {
          "$value": "#EBF3FE"
        },
        "100": {
          "$value": "#D6E7FD"
        },
        "500": {
          "$value": "#2B6CE0"
        },
        "600": {
          "$value": "#1F52B3"
        },
        "700": {
          "$value": "#173F8A"
        }
      },
      "teal": {
        "500": {
          "$value": "#1C8C82"
        },
        "600": {
          "$value": "#146B64"
        }
      },
      "amber": {
        "500": {
          "$value": "#C77B12"
        },
        "600": {
          "$value": "#9A5E0D"
        }
      },
      "red": {
        "500": {
          "$value": "#C33A2E"
        },
        "600": {
          "$value": "#9C2E24"
        }
      },
      "gray": {
        "50": {
          "$value": "#F7F8F9"
        },
        "100": {
          "$value": "#EDEFF1"
        },
        "300": {
          "$value": "#C7CCD1"
        },
        "500": {
          "$value": "#767E87"
        },
        "700": {
          "$value": "#454B52"
        },
        "900": {
          "$value": "#1C1F23"
        }
      }
    },
    "semantic": {
      "bg": {
        "default": {
          "$value": "{color.primitive.gray.50}"
        },
        "surface": {
          "$value": "#FFFFFF"
        }
      },
      "text": {
        "primary": {
          "$value": "{color.primitive.gray.900}"
        },
        "secondary": {
          "$value": "{color.primitive.gray.700}"
        },
        "inverse": {
          "$value": "#FFFFFF"
        }
      },
      "action": {
        "primary": {
          "$value": "{color.primitive.blue.600}"
        },
        "primary-hover": {
          "$value": "{color.primitive.blue.700}"
        }
      },
      "status": {
        "info": {
          "$value": "{color.primitive.blue.500}"
        },
        "success": {
          "$value": "{color.primitive.teal.500}"
        },
        "warning": {
          "$value": "{color.primitive.amber.500}"
        },
        "danger": {
          "$value": "{color.primitive.red.500}"
        }
      },
      "ai": {
        "generated-content-bg": {
          "$value": "{color.primitive.teal.500}",
          "$description": "Subtle background wash used behind AI-generated/AI-assisted content blocks (e.g. ambient scribe draft lines). Never used as the sole indicator of AI-generated status \u2014 always paired with a text label per the March/July/November accessibility audits' color-only-status finding."
        },
        "low-confidence-underline": {
          "$value": "{color.primitive.amber.500}",
          "$description": "Per-line low-confidence indicator introduced in the ambient scribe v0.3/GA work. Underline style, not color-fill, specifically because of the recurring color-only-status accessibility finding."
        }
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "0": {
      "$value": "0px"
    },
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "6": {
      "$value": "24px"
    },
    "8": {
      "$value": "32px"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "8px"
    },
    "lg": {
      "$value": "12px"
    },
    "pill": {
      "$value": "999px"
    }
  },
  "typography": {
    "$type": "typography",
    "body-md": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "15px",
        "fontWeight": 400,
        "lineHeight": "22px"
      }
    },
    "body-sm": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": "18px"
      }
    },
    "heading-md": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "20px",
        "fontWeight": 600,
        "lineHeight": "26px"
      }
    },
    "label-sm": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "12px",
        "fontWeight": 500,
        "lineHeight": "16px"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "touch-target-min": {
      "$value": "44px",
      "$description": "Minimum interactive touch target size. Referenced directly by the 2025-11-18 mobile accessibility audit, which found alert-triage icons shipping at 32px."
    },
    "icon-sm": {
      "$value": "16px"
    },
    "icon-md": {
      "$value": "20px"
    },
    "icon-lg": {
      "$value": "24px"
    }
  }
}
